{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:essemble:schema:profile:v1",
  "title": "ESsemble profile",
  "type": "object",
  "required": ["schemaVersion", "name", "selection", "scopes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "selection": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scopes": {
      "type": "array",
      "items": {
        "enum": ["runtime", "build", "compose", "native", "optionalRuntime", "validation", "benchmark", "prototype", "integration"]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
